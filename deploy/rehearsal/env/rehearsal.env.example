# E1.8 非生产演练 env 模板（不含真实凭据，禁止写入生产密钥）
#
# scripts/Invoke-Rehearsal.ps1 会把本文件复制为 ../.runtime/rehearsal.env，
# 并把 __REHEARSAL_*__ 占位符替换为本地一次性随机值。.runtime/ 已被 .gitignore 忽略。
#
# 数据库用户/库名固定，用于隔离：
#   V1 = flower_e18_v1，V2 = flower_e18_v2（由 db/init 脚本创建）
POSTGRES_USER=flower_e18
POSTGRES_PASSWORD=__REHEARSAL_DB_PASSWORD__
POSTGRES_DB=flower_e18_v1
DATABASE_URL=postgresql://flower_e18:__REHEARSAL_DB_PASSWORD__@db:5432/flower_e18_v1?schema=public
V2_DATABASE_URL=postgresql://flower_e18:__REHEARSAL_DB_PASSWORD__@db:5432/flower_e18_v2?schema=public

# Auth.js / NextAuth（本地随机值）
AUTH_SECRET=__REHEARSAL_AUTH_SECRET__
NEXTAUTH_SECRET=__REHEARSAL_AUTH_SECRET__
NEXTAUTH_URL=http://127.0.0.1:18080
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080
NEXT_PUBLIC_ASSET_BASE_URL=http://127.0.0.1:18080

# 生产初始化管理员（仅演练用随机账号；初始化后即为普通测试账号）
# 密码由脚本写入 .runtime/secrets/bootstrap-admin-password.txt 并以只读方式挂载
V2_BOOTSTRAP_ADMIN_USERNAME=e18_bootstrap_admin

# 以下外部服务在演练中留空占位，不配置真实密钥，不影响迁移/健康/登录页冒烟
STORAGE_DRIVER=oss
ENABLE_OSS_UPLOAD=false
ENABLE_LEGACY_UPLOADS=false
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
DEEPSEEK_API_KEY=
UPLOAD_MAX_SIZE_MB=3
