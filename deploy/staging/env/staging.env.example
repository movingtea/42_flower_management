# Flower WMS Sprint E2 staging env 模板（占位符；禁止写入真实生产凭据）
#
# scripts/Invoke-Staging.ps1 会把本文件复制为 deploy/staging/.runtime/<name>.env，
# 并替换 __STAGING_*__ 占位符为每次运行生成的随机本地值。.runtime/ 已 gitignore。
#
# 数据库（基线项目）：
#   V1 = flower_e2_v1（由 POSTGRES_DB 创建）
#   V2 = flower_e2_v2_test（由 db/init 脚本按 V2_DB_NAME 创建）
#   说明：V2 库名以 _test 结尾，便于本机用 V2 test seed 写入合成数据（seed 要求本地库名后缀 _test）。
POSTGRES_USER=flower_e2_stage
POSTGRES_PASSWORD=__STAGING_DB_PASSWORD__
POSTGRES_DB=flower_e2_v1
V2_DB_NAME=flower_e2_v2_test
DATABASE_URL=postgresql://flower_e2_stage:__STAGING_DB_PASSWORD__@db:5432/flower_e2_v1?schema=public
V2_DATABASE_URL=postgresql://flower_e2_stage:__STAGING_DB_PASSWORD__@db:5432/flower_e2_v2_test?schema=public

# Auth.js / NextAuth（本地随机值；NEXTAUTH_URL 与 STAGING_WEB_PORT 对应）
AUTH_SECRET=__STAGING_AUTH_SECRET__
NEXTAUTH_SECRET=__STAGING_AUTH_SECRET__
NEXTAUTH_URL=__STAGING_WEB_URL__
NEXT_PUBLIC_API_URL=__STAGING_WEB_URL__
NEXT_PUBLIC_ASSET_BASE_URL=__STAGING_WEB_URL__

# 外部服务：staging 使用隔离测试配置，留空/关闭，不配置真实密钥
STORAGE_DRIVER=oss
ENABLE_OSS_UPLOAD=false
ENABLE_LEGACY_UPLOADS=false
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
DEEPSEEK_API_KEY=
UPLOAD_MAX_SIZE_MB=3
