# Sprint E3.4 metrics controlled-failure evidence (sanitized)
# run_id: 20261110-1701 (UTC)
# environment: same route handlers, but DATABASE_URL/V2_DATABASE_URL point at a closed
#   loopback port (native PG 5432 and dev container 55432 were not touched).
#   The real health route returned 503 with failedDb=both, so the snapshot shows the 5xx,
#   failed DB-probe counters and the alert judgement.
# sample health event:
#   2026-11-10T17:00:34.220Z WARN  http.health.check {"outcome":"failure","status":503,"v1DurationMs":254,"v2DurationMs":255,"failedDb":"both"} requestId=demo-health-00
#   2026-11-10T17:00:34.237Z WARN  http.health.check {"outcome":"failure","status":503,"v1DurationMs":7,"v2DurationMs":8,"failedDb":"both"} requestId=demo-health-01

MODE=failure
HEALTH_STATUSES=503,503,503,503,503,503
METRICS_STATUSES=unauth:401,it_admin:403,business_role:200
CONTENT_TYPE=text/plain; version=0.0.4; charset=utf-8
CACHE_CONTROL=no-store
PROMETHEUS_BYTES=3507 FRESH_SNAPSHOT_BYTES=3507
PROMETHEUS_BEGIN
# HELP wms_http_requests_total Total HTTP requests observed.
# TYPE wms_http_requests_total counter
wms_http_requests_total{method="GET",route="/api/health",status_class="5xx"} 6
# HELP wms_http_5xx_total Total HTTP 5xx responses observed.
# TYPE wms_http_5xx_total counter
wms_http_5xx_total{route="/api/health"} 6
# HELP wms_http_request_duration_ms HTTP request duration in milliseconds.
# TYPE wms_http_request_duration_ms histogram
wms_http_request_duration_ms_bucket{route="/api/health",le="50"} 5
wms_http_request_duration_ms_bucket{route="/api/health",le="100"} 5
wms_http_request_duration_ms_bucket{route="/api/health",le="200"} 5
wms_http_request_duration_ms_bucket{route="/api/health",le="500"} 6
wms_http_request_duration_ms_bucket{route="/api/health",le="1000"} 6
wms_http_request_duration_ms_bucket{route="/api/health",le="2000"} 6
wms_http_request_duration_ms_bucket{route="/api/health",le="5000"} 6
wms_http_request_duration_ms_bucket{route="/api/health",le="+Inf"} 6
wms_http_request_duration_ms_count{route="/api/health"} 6
wms_http_request_duration_ms_sum{route="/api/health"} 350
# HELP wms_db_probe_total Database probe results.
# TYPE wms_db_probe_total counter
wms_db_probe_total{db="v1",outcome="failure"} 6
wms_db_probe_total{db="v2",outcome="failure"} 6
# HELP wms_db_probe_duration_ms Database probe duration in milliseconds.
# TYPE wms_db_probe_duration_ms histogram
wms_db_probe_duration_ms_bucket{db="v1",le="50"} 5
wms_db_probe_duration_ms_bucket{db="v1",le="100"} 5
wms_db_probe_duration_ms_bucket{db="v1",le="200"} 5
wms_db_probe_duration_ms_bucket{db="v1",le="500"} 6
wms_db_probe_duration_ms_bucket{db="v1",le="1000"} 6
wms_db_probe_duration_ms_bucket{db="v1",le="2000"} 6
wms_db_probe_duration_ms_bucket{db="v1",le="5000"} 6
wms_db_probe_duration_ms_bucket{db="v1",le="+Inf"} 6
wms_db_probe_duration_ms_count{db="v1"} 6
wms_db_probe_duration_ms_sum{db="v1"} 274
wms_db_probe_duration_ms_bucket{db="v2",le="50"} 5
wms_db_probe_duration_ms_bucket{db="v2",le="100"} 5
wms_db_probe_duration_ms_bucket{db="v2",le="200"} 5
wms_db_probe_duration_ms_bucket{db="v2",le="500"} 6
wms_db_probe_duration_ms_bucket{db="v2",le="1000"} 6
wms_db_probe_duration_ms_bucket{db="v2",le="2000"} 6
wms_db_probe_duration_ms_bucket{db="v2",le="5000"} 6
wms_db_probe_duration_ms_bucket{db="v2",le="+Inf"} 6
wms_db_probe_duration_ms_count{db="v2"} 6
wms_db_probe_duration_ms_sum{db="v2"} 280
# HELP wms_cron_rounds_total Cron task rounds observed.
# TYPE wms_cron_rounds_total counter
wms_cron_rounds_total{task="inventory-sync",outcome="success"} 1
wms_cron_rounds_total{task="order-expiry",outcome="failure"} 2
# HELP wms_cron_last_success_timestamp_seconds Unix timestamp of the last successful cron round.
# TYPE wms_cron_last_success_timestamp_seconds gauge
wms_cron_last_success_timestamp_seconds{task="inventory-sync"} 1794330034
# HELP wms_cron_consecutive_failures Consecutive failed cron rounds for the task.
# TYPE wms_cron_consecutive_failures gauge
wms_cron_consecutive_failures{task="inventory-sync"} 0
wms_cron_consecutive_failures{task="order-expiry"} 2
# HELP wms_login_failures_total Authentication failures by provider and reason.
# TYPE wms_login_failures_total counter
wms_login_failures_total{provider="legacy",reason="unknown_user"} 1
wms_login_failures_total{provider="v2",reason="wrong_password"} 1
# HELP wms_business_failures_total Stable business failure signals.
# TYPE wms_business_failures_total counter
wms_business_failures_total{signal="stock_negative_blocked"} 1
PROMETHEUS_END
ALERT_JUDGEMENT_HTTP_5XX_HEALTH=6
ALERT_JUDGEMENT_CRON_CONSECUTIVE_FAILURES=2
