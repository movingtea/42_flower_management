# 本地开发：复制到 flower-wms-system/.env.local（Next.js 本地开发优先读取，无需放进 .env）。
# 生产：在 Compose .env 中配置，见 ../docker-compose.example.yml。
# The old login/session remains on the legacy database during the v2 transition.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:55432/flower_legacy_dev?schema=public"
V2_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:55432/flower_v2_dev?schema=public"
# For db:v2:seed:test and db:v2:reset:test, use a separate local database ending in _test.

# Keep the existing AUTH_SECRET / NEXTAUTH_SECRET from .env.
